########################################

# 🌍 Application

########################################
APP_NAME=QOOQZ
APP_ENV=development
APP_DEBUG=true
APP_URL=https://hcsfcs.top
API_VERSION=v1
APP_TIMEZONE=Asia/Dubai

########################################

# 🔐 Security

########################################
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM
JWT_EXPIRES_IN=3600

########################################

# 🗄️ Database

########################################
DB_CONNECTION=mysql
DB_HOST=sv61.ifastnet10.org
DB_PORT=3306
DB_NAME=hcsfcsto_qooqz
DB_USER=hcsfcsto_user
DB_PASS=Mohd28332@
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

########################################

# 🔵 Google OAuth

########################################
GOOGLE_CLIENT_ID=365881143367-5fes125978be0mf3cq2cvco7t0vf33gh.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PUT_YOUR_REAL_SECRET_HERE
GOOGLE_REDIRECT_URI=https://hcsfcs.top/api/auth?__action=google_callback

########################################

# 💬 WhatsApp Verification

########################################
WHATSAPP_VERIFY_EXPIRY=300
WHATSAPP_ALLOWED_DRIFT=5
WHATSAPP_SESSION_BIND=true

########################################

# ⚡ Performance

########################################
CACHE_DRIVER=file
CACHE_PREFIX=qooqz_

########################################

# 📊 Logging

########################################
LOG_CHANNEL=file
LOG_LEVEL=debug

########################################

# 🌐 Localization

########################################
DEFAULT_LANG=ar
SUPPORTED_LANGS=ar,en

########################################

# 🔒 CORS

########################################
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

########################################

# 🧪 Features

########################################
FEATURE_GOOGLE_LOGIN=true
FEATURE_WHATSAPP_LOGIN=true
FEATURE_EMAIL_VERIFICATION=true

########################################

# 🔔 Firebase Cloud Messaging (FCM)

########################################
# VAPID Key: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Key pair
# يبدأ عادةً بـ B... (مفتاح VAPID العام)
FCM_VAPID_KEY=BEzn1WFf6r1OSnEEBK1RGlvunNwfDlLgZy6stIgdWpg3mU7QmX2swU4zifu-gpiF_1I0_xcEPNDAyanKw9tZ57o

# Server Key: Firebase Console → Project Settings → Cloud Messaging → Server key
# ⚠️ Legacy API — تم إيقافه من Google. استخدم Service Account بدلاً منه
FCM_SERVER_KEY=REPLACE_WITH_YOUR_SERVER_KEY

# مسار ملف Service Account JSON (موصى به لـ FCM v1 API)
# Firebase Console → Project Settings → Service accounts → Generate new private key
# ضع الملف في: api/shared/config/firebase-service-account.json
# أو حدد المسار هنا:
# FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# Email & SMS flags
# MAIL_ENABLED=false
# SMS_ENABLED=false
